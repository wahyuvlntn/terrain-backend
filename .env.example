# AFDD backend configuration. Copy to .env (read from the working directory)
# or set the variables in the environment. Values shown are the defaults.

# --- HTTP API -----------------------------------------------------------------
HTTP_ADDR=:4500
# Serve HTTPS (the web UI calls https://<host>:4500). Disable when a reverse
# proxy terminates TLS.
HTTP_TLS=true
# PEM certificate/key. When empty a self-signed certificate is generated in DATA_DIR/tls.
TLS_CERT_FILE=
TLS_KEY_FILE=
# Organisation / project segments of /api/js-service/exposed/execute/{org}/{project}/...
ORG_ALIAS=local
PROJECT_ALIAS=digital_twin_afdd
# Reject requests whose {org}/{project} do not match the aliases above.
STRICT_PROJECT_PATH=false
# Comma separated list of allowed CORS origins ("*" for any). Not needed when
# the UI is served from the same origin (nginx proxy or STATIC_DIR).
CORS_ORIGINS=
# Optional: serve the built single frontend (dist/) from this process.
STATIC_DIR=

# --- PostgreSQL ---------------------------------------------------------------
DATABASE_URL=postgres://afdd:afdd@localhost:5432/afdd?sslmode=disable

# --- MinIO / S3 object storage --------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=afdd
MINIO_USE_SSL=false
MINIO_REGION=

# --- Embedded MQTT broker -------------------------------------------------------
MQTT_ENABLED=true
# Plain MQTT for MQTT_SERVER data sources (devices publish to local.digital_twin_afdd.<gateway alias>).
MQTT_TCP_ADDR=:1883
# MQTT over TLS for devices.
MQTT_TLS_ADDR=:8883
# Port shown to users in the data source screen (defaults to the TLS port).
MQTT_PUBLIC_PORT=
# WebSocket listener used by the web UI for live notifications (wss://<host>:9002/mqtt).
MQTT_WS_ADDR=:9002
MQTT_WS_TLS=true
# Credentials of the web UI (VITE_MQTT_USERNAME / VITE_MQTT_PASSWORD). Read-only access to the notification topic.
MQTT_CLIENT_USERNAME=afdd_ui
MQTT_CLIENT_PASSWORD=indie123
MQTT_NOTIFICATION_TOPIC=AFDD_NOTIFICATION

# --- Authentication -------------------------------------------------------------
SESSION_TTL=168h
# Initial superuser created when no superuser exists. When the password is
# empty a random one is generated and printed in the log once.
BOOTSTRAP_USERNAME=superuser
BOOTSTRAP_PASSWORD=
# Demo mode: sign every visitor in as this user without a password (no login
# page). Leave empty in any deployment that needs authentication.
DEMO_USER=

# --- Engine ---------------------------------------------------------------------
# Evaluation cycle (status, alarms, thresholds, SPC, diagnosis).
EVAL_INTERVAL=10s
# Interval at which logged parameters are stored.
LOG_INTERVAL=1m
# Equipment without fresh good-quality data for this long is OFFLINE.
OFFLINE_TIMEOUT=5m
# Raw measurements and notifications older than this are deleted (0 = keep forever).
RETENTION_DAYS=730
# Maximum run time of a user script (status/alarm/mapping expressions).
SCRIPT_TIMEOUT=500ms
# Minimum time between two early warnings for the same equipment/relation/issue.
EARLY_WARNING_COOLDOWN=1h
# Depth of the location tree treated as "building" in maintenance screens
# (0 = root locations are buildings, their children floors, then rooms).
BUILDING_LEVEL=0
# Time zone used when a request does not carry the client time zone.
DEFAULT_TIMEZONE=Asia/Singapore

# --- Licensing ------------------------------------------------------------------
# base64 ed25519 public key used to verify uploaded license files
# (generate a key pair with: server license keygen).
LICENSE_PUBLIC_KEY=
# When true, equipment without a valid license is not evaluated.
LICENSE_ENFORCED=false

# --- Misc -----------------------------------------------------------------------
LOG_LEVEL=info
DATA_DIR=./data

# Frontend HTTP port in the complete Compose stack.
FRONTEND_PORT=8082
